# ── bizopease — secrets template ─────────────────────────────────────────────
# Copy to ".env" (gitignored) and fill in. NEVER commit the real .env.

# GitHub push (Personal Access Token, "repo" scope) — used by scripts/push.sh
# Create at: https://github.com/settings/tokens  (Fine-grained: repo contents R/W)
GITHUB_TOKEN=

# ── Cloudflare R2 (WAL-G Postgres backups + uploads) ─────────────────────────
# R2: Cloudflare dashboard → R2 → Create bucket → "Manage R2 API Tokens"
R2_ACCOUNT_ID=
R2_BUCKET_NAME=bizopease-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# ── Razorpay subscriptions (paywall) ─────────────────────────────────────────
# Dashboard → Settings → API Keys; create Plans for Starter & Pro
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_WEBHOOK_SECRET=

# ── SaaS control-plane ───────────────────────────────────────────────────────
JWT_SECRET=
SUPERADMIN_USERNAME=bizopeaseadmin
SUPERADMIN_PASSWORD=

# ── Odoo provisioning (server-side; control-plane creates tenant DBs) ────────
ODOO_URL=https://odoo.robifel.in
ODOO_MASTER_PASSWORD=

# QZ Tray signing private key (PKCS8 DER base64). Build-time only; dist embeds it.
VITE_QZ_PRIVATE_KEY=
