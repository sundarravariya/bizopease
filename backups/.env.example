# ── WAL-G Cloudflare R2 Backups Configuration ───────────────────
# Copy this to ".env" inside the backups directory on the remote server

# The R2 bucket where backups will be stored (e.g. s3://bucket-name)
WALG_PG_BACKUP_PATH=s3://bizopease-backups

# Cloudflare R2 API Token Credentials (Access Key & Secret)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare R2 Endpoint: https://<account_id>.r2.cloudflarestorage.com
AWS_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# S3 compatibility settings (required for R2)
AWS_S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1

# PostgreSQL credentials for WAL-G to connect to the local DB instance
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
