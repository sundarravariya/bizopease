<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Attendance: a non-admin employee may only see/manage their OWN rows. -->
        <record id="rule_attendance_day_own" model="ir.rule">
            <field name="name">Attendance: own records only</field>
            <field name="model_id" ref="model_robifel_attendance_day"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_attendance_day_admin" model="ir.rule">
            <field name="name">Attendance: admin sees all</field>
            <field name="model_id" ref="model_robifel_attendance_day"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Live location: a non-admin may only see/write their OWN pings. -->
        <record id="rule_emp_location_own" model="ir.rule">
            <field name="name">Location: own records only</field>
            <field name="model_id" ref="model_robifel_employee_location"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
        <record id="rule_emp_location_admin" model="ir.rule">
            <field name="name">Location: admin sees all</field>
            <field name="model_id" ref="model_robifel_employee_location"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
