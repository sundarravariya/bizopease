<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_biz_supplier_reorder_list" model="ir.ui.view">
        <field name="name">biz.supplier.reorder.list</field>
        <field name="model">biz.supplier.reorder</field>
        <field name="arch" type="xml">
            <list string="Supplier Reorder" create="false">
                <field name="urgency" widget="badge"
                       decoration-danger="urgency == 'critical'"
                       decoration-warning="urgency == 'moderate'"/>
                <field name="product_id"/>
                <field name="sku"/>
                <field name="physical_stock"/>
                <field name="incoming_qty"/>
                <field name="daily_avg_sales"/>
                <field name="days_in_hand"/>
                <field name="stockout_date"/>
                <field name="order_now_qty"/>
                <field name="next_order_date"/>
                <field name="action_required"/>
            </list>
        </field>
    </record>

    <record id="view_biz_supplier_reorder_search" model="ir.ui.view">
        <field name="name">biz.supplier.reorder.search</field>
        <field name="model">biz.supplier.reorder</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <filter name="action_required" string="Action Required" domain="[('action_required','=',True)]"/>
                <filter name="critical" string="Critical" domain="[('urgency','=','critical')]"/>
            </search>
        </field>
    </record>

    <record id="action_biz_supplier_reorder" model="ir.actions.act_window">
        <field name="name">Supplier Reorder</field>
        <field name="res_model">biz.supplier.reorder</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_biz_supplier_reorder_generate_form" model="ir.ui.view">
        <field name="name">biz.supplier.reorder.generate.form</field>
        <field name="model">biz.supplier.reorder.generate</field>
        <field name="arch" type="xml">
            <form string="Generate Supplier Reorder">
                <group>
                    <field name="warehouse_id"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_biz_supplier_reorder_generate" model="ir.actions.act_window">
        <field name="name">Generate Supplier Reorder</field>
        <field name="res_model">biz.supplier.reorder.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_biz_supplier_reorder" name="Supplier Reorder" parent="menu_biz_os_root"
              action="action_biz_supplier_reorder" sequence="30"/>
    <menuitem id="menu_biz_supplier_reorder_gen" name="Generate Supplier Reorder" parent="menu_biz_os_root"
              action="action_biz_supplier_reorder_generate" sequence="31"/>
</odoo>
