<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Ledger detail (SQL view) -->
    <record id="view_biz_ledger_list" model="ir.ui.view">
        <field name="name">biz.ledger.list</field>
        <field name="model">biz.ledger</field>
        <field name="arch" type="xml">
            <list string="Partner Ledger" create="false">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="name"/>
                <field name="ref"/>
                <field name="debit" sum="Total Debit"/>
                <field name="credit" sum="Total Credit"/>
                <field name="balance" sum="Net"/>
            </list>
        </field>
    </record>

    <record id="view_biz_ledger_search" model="ir.ui.view">
        <field name="name">biz.ledger.search</field>
        <field name="model">biz.ledger</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <filter name="group_partner" string="Partner" context="{'group_by':'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_biz_ledger" model="ir.actions.act_window">
        <field name="name">Partner Ledger</field>
        <field name="res_model">biz.ledger</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Summary (Tally group view) -->
    <record id="view_biz_ledger_summary_list" model="ir.ui.view">
        <field name="name">biz.ledger.summary.list</field>
        <field name="model">biz.ledger.summary</field>
        <field name="arch" type="xml">
            <list string="Partner Balances" create="false">
                <field name="partner_id"/>
                <field name="debit"/>
                <field name="credit"/>
                <field name="balance"/>
                <button name="action_open_ledger_details" string="Open" type="object" icon="fa-search"/>
            </list>
        </field>
    </record>
    <record id="action_biz_ledger_summary" model="ir.actions.act_window">
        <field name="name">Partner Balances</field>
        <field name="res_model">biz.ledger.summary</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Manual entry wizard -->
    <record id="view_biz_manual_entry_form" model="ir.ui.view">
        <field name="name">biz.manual.entry.wizard.form</field>
        <field name="model">biz.manual.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual Ledger Entry">
                <group>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="entry_type"/>
                    <field name="amount"/>
                    <field name="narration"/>
                </group>
                <field name="line_ids">
                    <list>
                        <field name="move_id"/>
                        <field name="account_id"/>
                        <field name="amount_residual"/>
                    </list>
                </field>
                <footer>
                    <button name="action_post_entry" string="Post Entry" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_biz_manual_entry" model="ir.actions.act_window">
        <field name="name">Manual Ledger Entry</field>
        <field name="res_model">biz.manual.entry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_biz_ledger_summary" name="Partner Balances" parent="menu_biz_os_root"
              action="action_biz_ledger_summary" sequence="50"/>
    <menuitem id="menu_biz_ledger" name="Partner Ledger" parent="menu_biz_os_root"
              action="action_biz_ledger" sequence="51"/>
    <menuitem id="menu_biz_manual_entry" name="Manual Entry" parent="menu_biz_os_root"
              action="action_biz_manual_entry" sequence="52"/>
</odoo>
