<odoo>
  <data>

    <!-- List View for Flipkart FSNs -->
    <record id="view_sr_multi_barcode_list" model="ir.ui.view">
      <field name="name">sr.multi.barcode.list</field>
      <field name="model">sr.multi.barcode</field>
      <field name="arch" type="xml">
        <list string="Flipkart FSNs" editable="bottom" create="true">
          <field name="name" string="FSN (Barcode)"/>
          <field name="product_id" string="Odoo Product"/>
        </list>
      </field>
    </record>

    <!-- Form View for editing individual FSNs -->
    <record id="view_sr_multi_barcode_form" model="ir.ui.view">
      <field name="name">sr.multi.barcode.form</field>
      <field name="model">sr.multi.barcode</field>
      <field name="arch" type="xml">
        <form string="Flipkart FSN">
          <sheet>
            <group>
              <field name="name" string="FSN (Barcode)"/>
              <field name="product_id"/>
              <field name="product_tmpl_id"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Action: Opens list + form -->
    <record id="action_sr_multi_barcode_manager" model="ir.actions.act_window">
      <field name="name">Flipkart FSNs</field>
      <field name="res_model">sr.multi.barcode</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Top-level FSN menus removed – FSNs are accessible under
         Business OS > Setup & Master Data > Flipkart FSNs (defined in flipkart_os/views/menus.xml) -->

  </data>
</odoo>
