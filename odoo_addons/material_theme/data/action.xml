<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Client action — noupdate so user edits are preserved -->
        <record id="action_material_app_screen" model="ir.actions.client">
            <field name="name">Home</field>
            <field name="tag">material_theme.app_screen</field>
        </record>
    </data>

    <data>
        <!-- Menuitem outside noupdate so sequence is always applied on upgrade -->
        <menuitem id="menu_material_app_screen"
                  name="Apps Dash"
                  action="action_material_app_screen"
                  web_icon="oi,oi-apps,#111111,#FFFFFF"
                  sequence="-100"/>
    </data>
</odoo>
