<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Returns Management List View -->
    <record id="view_flipkart_return_management_tree" model="ir.ui.view">
        <field name="name">flipkart.return.management.tree</field>
        <field name="model">flipkart.return.management</field>
        <field name="arch" type="xml">
            <list string="Returns Management" decoration-info="state == 'draft'" decoration-success="state == 'processed'" decoration-danger="state == 'rejected'" decoration-muted="state == 'cancelled'">
                <field name="return_requested_date"/>
                <field name="account_id" optional="show"/>
                <field name="return_id"/>
                <field name="tracking_id"/>
                <field name="fsn"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="return_reason"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'processed'" decoration-danger="state == 'rejected'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Returns Management Form View -->
    <record id="view_flipkart_return_management_form" model="ir.ui.view">
        <field name="name">flipkart.return.management.form</field>
        <field name="model">flipkart.return.management</field>
        <field name="arch" type="xml">
            <form string="Return Record">
                <header>
                    <button name="action_confirm_inward" string="Confirm Inward" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_reject" string="Reject Return" type="object" invisible="state != 'draft'" class="btn-danger"/>
                    <button name="action_reverse" string="Reverse Inward" type="object" invisible="state != 'processed'" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="return_id"/>
                            <field name="account_id"/>
                            <field name="tracking_id"/>
                            <field name="fsn"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="return_requested_date"/>
                            <field name="picking_id" readonly="1" invisible="not picking_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stock Movements">
                            <field name="stock_move_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="product_qty" string="Demand"/>
                                    <field name="quantity" string="Done"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Returns Management Search View -->
    <record id="view_flipkart_return_management_search" model="ir.ui.view">
        <field name="name">flipkart.return.management.search</field>
        <field name="model">flipkart.return.management</field>
        <field name="arch" type="xml">
            <search string="Search Returns">
                <field name="tracking_id"/>
                <field name="account_id"/>
                <field name="return_id"/>
                <field name="fsn"/>
                <filter string="Pending Inward" name="pending" domain="[('state', '=', 'draft')]"/>
                <filter string="Inwarded" name="processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
            </search>
        </field>
    </record>

    <!-- Server Actions for Bulk Operations -->
    <record id="action_server_confirm_inward_returns" model="ir.actions.server">
        <field name="name">Bulk Confirm Inward</field>
        <field name="model_id" ref="model_flipkart_return_management"/>
        <field name="binding_model_id" ref="model_flipkart_return_management"/>
        <field name="state">code</field>
        <field name="code">
            records.action_confirm_inward()
        </field>
    </record>

    <record id="action_server_reject_returns" model="ir.actions.server">
        <field name="name">Bulk Reject Returns</field>
        <field name="model_id" ref="model_flipkart_return_management"/>
        <field name="binding_model_id" ref="model_flipkart_return_management"/>
        <field name="state">code</field>
        <field name="code">
            records.action_reject()
        </field>
    </record>

    <record id="action_server_reverse_returns" model="ir.actions.server">
        <field name="name">Bulk Reverse Inward</field>
        <field name="model_id" ref="model_flipkart_return_management"/>
        <field name="binding_model_id" ref="model_flipkart_return_management"/>
        <field name="state">code</field>
        <field name="code">
            records.action_reverse()
        </field>
    </record>

    <!-- Returns Management Action -->
    <record id="action_flipkart_return_management" model="ir.actions.act_window">
        <field name="name">Returns Management</field>
        <field name="res_model">flipkart.return.management</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <!-- Scanning Wizard View -->
    <record id="view_flipkart_return_scan_wizard_form" model="ir.ui.view">
        <field name="name">flipkart.return.scan.wizard.form</field>
        <field name="model">flipkart.return.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Scan Return Tracking ID">
                <group>
                    <field name="tracking_id" default_focus="1" placeholder="Scan Tracking ID here..."/>
                </group>
                <group invisible="not return_record_id">
                    <field name="return_record_id"/>
                    <field name="fsn"/>
                    <field name="product_name" style="font-weight: bold; font-size: 1.2em; color: green;"/>
                    <field name="has_components" invisible="1"/>
                </group>
                <separator string="Kit Components — tick the items to inward" invisible="not has_components"/>
                <field name="component_line_ids" invisible="not return_record_id" nolabel="1">
                    <list editable="bottom" create="0" delete="0" decoration-muted="not selected">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="product_name" string="Component"/>
                        <field name="qty"/>
                        <field name="product_id" column_invisible="1"/>
                    </list>
                </field>
                <group invisible="return_record_id or not tracking_id">
                    <p class="text-danger">No matching pending return found for this Tracking ID.</p>
                </group>
                <footer>
                    <button name="action_confirm_and_next" string="Inward and Scan Next" type="object" class="btn-primary" invisible="not return_record_id"/>
                    <button name="action_reject_and_next" string="Reject and Scan Next" type="object" class="btn-danger" invisible="not return_record_id"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_flipkart_return_scan" model="ir.actions.act_window">
        <field name="name">Scan Returns</field>
        <field name="res_model">flipkart.return.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Upload Returns Wizard -->
    <record id="view_flipkart_return_upload_form" model="ir.ui.view">
        <field name="name">flipkart.return.upload.form</field>
        <field name="model">flipkart.return.upload</field>
        <field name="arch" type="xml">
            <form string="Upload Returns CSV">
                <group>
                    <field name="account_id"/>
                    <field name="file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Upload" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_flipkart_return_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Returns CSV</field>
        <field name="res_model">flipkart.return.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
