<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employees: own tasks only. Operations dept employees see all tasks. -->
    <record id="rule_biz_task_own" model="ir.rule">
        <field name="name">Biz Task: own tasks</field>
        <field name="model_id" ref="model_biz_task"/>
        <field name="domain_force">[(1, '=', 1)] if any(e.department_id.name == 'Operations' for e in user.employee_ids) else [('assignee_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Managers (Settings/admin): see and manage every task. -->
    <record id="rule_biz_task_all" model="ir.rule">
        <field name="name">Biz Task: all tasks (managers)</field>
        <field name="model_id" ref="model_biz_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
