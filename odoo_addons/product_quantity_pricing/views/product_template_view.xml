<odoo>
    <record id="view_product_template_form_qprice" model="ir.ui.view">
        <field name="name">product.template.form.qprice</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Quantity Prices">
                    <field name="quantity_price_ids">
                        <list editable="bottom">
                            <field name="qty_from"/>
                            <field name="qty_to"/>
                            <field name="bracket_label"/>
                            <field name="price"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
