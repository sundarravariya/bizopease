<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_flipkart_bill_payment_transaction" model="ir.sequence">
        <field name="name">Bill Payment Transaction</field>
        <field name="code">flipkart.bill.payment.transaction</field>
        <field name="prefix">BPT/</field>
        <field name="padding">5</field>
    </record>

    <record id="view_flipkart_bill_payment_vendor_list" model="ir.ui.view">
        <field name="name">flipkart.bill.payment.vendor.list</field>
        <field name="model">flipkart.bill.payment.vendor</field>
        <field name="arch" type="xml">
            <list string="Bill/Payment Vendors" decoration-bf="1">
                <field name="name"/>
                <field name="deduction_percent"/>
                <field name="phone"/>
                <field name="balance" decoration-danger="balance &gt; 0" decoration-success="balance &lt;= 0" decoration-bf="balance != 0"/>
            </list>
        </field>
    </record>

    <record id="view_flipkart_bill_payment_vendor_form" model="ir.ui.view">
        <field name="name">flipkart.bill.payment.vendor.form</field>
        <field name="model">flipkart.bill.payment.vendor</field>
        <field name="arch" type="xml">
            <form string="Bill/Payment Vendor">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="transaction_ids" widget="statinfo" string="Transactions"/>
                        </button>
                        <button name="action_view_ledger" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="ledger_ids" widget="statinfo" string="Ledger"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Bill/Payment Vendor"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="deduction_percent"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="balance"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flipkart_money_associate_list" model="ir.ui.view">
        <field name="name">flipkart.money.associate.list</field>
        <field name="model">flipkart.money.associate</field>
        <field name="arch" type="xml">
            <list string="Money Associates" decoration-bf="1">
                <field name="name"/>
                <field name="phone"/>
                <field name="balance" decoration-success="balance &gt; 0" decoration-danger="balance &lt; 0" decoration-bf="balance != 0"/>
            </list>
        </field>
    </record>

    <record id="view_flipkart_money_associate_form" model="ir.ui.view">
        <field name="name">flipkart.money.associate.form</field>
        <field name="model">flipkart.money.associate</field>
        <field name="arch" type="xml">
            <form string="Money Associate">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_ledger" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="ledger_ids" widget="statinfo" string="Ledger"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Associate"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="balance"/>
                        </group>
                        <group>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flipkart_bill_payment_transaction_list" model="ir.ui.view">
        <field name="name">flipkart.bill.payment.transaction.list</field>
        <field name="model">flipkart.bill.payment.transaction</field>
        <field name="arch" type="xml">
            <list string="Bill/Payment Transactions"
                  decoration-danger="state=='pending'"
                  decoration-success="state in ('received', 'agent_paid')"
                  decoration-bf="1">
                <field name="date"/>
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="transfer_amount" sum="Total Transfer" decoration-danger="transfer_amount &gt; 0" decoration-bf="transfer_amount &gt; 0"/>
                <field name="deduction_amount" sum="Total Deducted" decoration-success="deduction_amount &gt; 0" decoration-bf="deduction_amount &gt; 0"/>
                <field name="expected_cash_amount" sum="Expected Cash" decoration-success="expected_cash_amount &gt; 0" decoration-bf="expected_cash_amount &gt; 0"/>
                <field name="actual_cash_received" sum="Cash Received" decoration-success="actual_cash_received &gt; 0" decoration-bf="actual_cash_received &gt; 0"/>
                <field name="received_by_id" optional="show"/>
                <field name="agent_payment_amount" optional="hide" decoration-success="agent_payment_amount &gt; 0" decoration-bf="agent_payment_amount &gt; 0"/>
                <field name="carrying_agent_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-danger="state=='pending'"
                       decoration-success="state in ('received', 'agent_paid')"/>
            </list>
        </field>
    </record>

    <record id="view_flipkart_bill_payment_vendor_ledger_transaction_list" model="ir.ui.view">
        <field name="name">flipkart.bill.payment.vendor.ledger.transaction.list</field>
        <field name="model">flipkart.bill.payment.transaction</field>
        <field name="arch" type="xml">
            <list string="Bill/Payment Vendor Ledger"
                  decoration-danger="vendor_balance_amount &gt; 0"
                  decoration-success="vendor_balance_amount &lt;= 0"
                  decoration-bf="1">
                <field name="date"/>
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="transfer_amount" sum="Total Transfer" decoration-danger="transfer_amount &gt; 0" decoration-bf="transfer_amount &gt; 0"/>
                <field name="deduction_amount" sum="Total Deducted" decoration-success="deduction_amount &gt; 0" decoration-bf="deduction_amount &gt; 0"/>
                <field name="actual_cash_received" sum="Cash Received" decoration-success="actual_cash_received &gt; 0" decoration-bf="actual_cash_received &gt; 0"/>
                <field name="agent_payment_amount" sum="Agent Paid" decoration-success="agent_payment_amount &gt; 0" decoration-bf="agent_payment_amount &gt; 0"/>
                <field name="vendor_settled_amount" sum="Total Settled" decoration-success="vendor_settled_amount &gt; 0" decoration-bf="vendor_settled_amount &gt; 0"/>
                <field name="vendor_balance_amount" sum="Net Balance" decoration-danger="vendor_balance_amount &gt; 0" decoration-success="vendor_balance_amount &lt;= 0" decoration-bf="vendor_balance_amount != 0"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_flipkart_bill_payment_entry_wizard_form" model="ir.ui.view">
        <field name="name">flipkart.bill.payment.entry.wizard.form</field>
        <field name="model">flipkart.bill.payment.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Bill/Payment Entry">
                <group>
                    <field name="entry_type" widget="radio"/>
                </group>
                <group invisible="entry_type!='bank_transfer'">
                    <group string="Bank Transfer">
                        <field name="date"/>
                        <field name="vendor_id" required="entry_type=='bank_transfer'"/>
                        <field name="transfer_amount" required="entry_type=='bank_transfer'"/>
                        <field name="deduction_percent"/>
                    </group>
                    <group string="Calculation">
                        <field name="expected_cash_amount" readonly="1"/>
                    </group>
                </group>
                <group invisible="entry_type=='bank_transfer'">
                    <field name="vendor_id"
                           invisible="entry_type in ('associate_transfer', 'expense') or (entry_type=='agent_payment' and agent_payment_source=='associate')"
                           required="entry_type not in ('bank_transfer', 'associate_transfer', 'expense') and not (entry_type=='agent_payment' and agent_payment_source=='associate')"/>
                    <field name="transaction_id"
                           invisible="entry_type in ('associate_transfer', 'expense') or (entry_type=='agent_payment' and agent_payment_source=='associate')"
                           placeholder="Leave blank to settle oldest pending transfer first"/>
                </group>
                <group string="Receive Cash" invisible="entry_type!='receive_payment'">
                    <field name="date"/>
                    <field name="received_by_id" required="entry_type=='receive_payment'"/>
                    <field name="actual_cash_received" required="entry_type=='receive_payment'"/>
                </group>
                <group string="Carrying Agent Payment" invisible="entry_type!='agent_payment'">
                    <field name="date"/>
                    <field name="agent_payment_source" required="entry_type=='agent_payment'"/>
                    <field name="received_by_id"
                           string="Associate"
                           invisible="agent_payment_source!='associate'"
                           required="entry_type=='agent_payment' and agent_payment_source=='associate'"/>
                    <field name="carrying_agent_id" required="entry_type=='agent_payment'"/>
                    <field name="agent_payment_amount" required="entry_type=='agent_payment'"/>
                </group>
                <group string="Associate Transfer" invisible="entry_type!='associate_transfer'">
                    <field name="date"/>
                    <field name="received_by_id" string="From Associate" required="entry_type=='associate_transfer'"/>
                    <field name="to_associate_id" required="entry_type=='associate_transfer'"/>
                    <field name="actual_cash_received" string="Transfer Amount" required="entry_type=='associate_transfer'"/>
                </group>
                <group string="Expenses" invisible="entry_type!='expense'">
                    <field name="date"/>
                    <field name="received_by_id" string="Associate" required="entry_type=='expense'"/>
                    <field name="actual_cash_received" string="Expense Amount" required="entry_type=='expense'"/>
                </group>
                <group>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Create Entry" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_flipkart_bill_payment_transaction_form" model="ir.ui.view">
        <field name="name">flipkart.bill.payment.transaction.form</field>
        <field name="model">flipkart.bill.payment.transaction</field>
        <field name="arch" type="xml">
            <form string="Bill/Payment Transaction">
                <header>
                    <button name="action_mark_cash_received"
                            string="Mark Cash Received"
                            type="object"
                            class="btn-primary"
                            invisible="payment_received"/>
                    <button name="action_reset_cash_received"
                            string="Reset Cash"
                            type="object"
                            invisible="not payment_received"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,received,agent_paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_ledgers" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="ledger_count" widget="statinfo" string="Ledger"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="1. Bank Transfer">
                            <field name="date"/>
                            <field name="vendor_id"/>
                            <field name="transfer_amount"/>
                            <field name="deduction_percent"/>
                        </group>
                        <group string="2. System Calculation">
                            <field name="deduction_amount" readonly="1"/>
                            <field name="expected_cash_amount" readonly="1"/>
                        </group>
                    </group>
                    <group string="3. Cash Received" invisible="not payment_received">
                        <field name="received_date"/>
                        <field name="received_by_id" required="payment_received"/>
                        <field name="actual_cash_received"/>
                    </group>
                    <group string="4. Carrying Agent Payment">
                        <field name="agent_payment_source"/>
                        <field name="received_by_id"
                               string="Associate"
                               invisible="agent_payment_source!='associate'"
                               required="agent_payment_source=='associate'"/>
                        <field name="carrying_agent_id" invisible="agent_payment_source=='none'" required="agent_payment_source!='none'"/>
                        <field name="agent_payment_amount" invisible="agent_payment_source=='none'" required="agent_payment_source!='none'"/>
                        <field name="agent_ledger_id" readonly="1" invisible="not agent_ledger_id"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flipkart_bill_vendor_ledger_list" model="ir.ui.view">
        <field name="name">flipkart.bill.vendor.ledger.list</field>
        <field name="model">flipkart.bill.vendor.ledger</field>
        <field name="arch" type="xml">
            <list string="Bill/Payment Vendor Ledger"
