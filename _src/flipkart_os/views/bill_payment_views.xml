                <field name="vendor_id"/>
                <field name="transaction_id"/>
                <field name="entry_type" widget="badge"
                       decoration-danger="entry_type=='bank_transfer'"
                       decoration-success="entry_type in ('deduction', 'cash_received', 'agent_payment')"/>
                <field name="debit" sum="Total Debit" decoration-danger="debit &gt; 0" decoration-bf="debit &gt; 0"/>
                <field name="credit" sum="Total Credit" decoration-success="credit &gt; 0" decoration-bf="credit &gt; 0"/>
                <field name="balance" sum="Net Balance" decoration-danger="balance &gt; 0" decoration-success="balance &lt; 0" decoration-bf="balance != 0"/>
                <field name="reference"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_flipkart_bill_vendor_ledger_summary_list" model="ir.ui.view">
        <field name="name">flipkart.bill.vendor.ledger.summary.list</field>
        <field name="model">flipkart.bill.vendor.ledger.summary</field>
        <field name="arch" type="xml">
            <list string="Bill/Payment Vendor Ledger Summary" create="0" edit="0" delete="0">
