                       decoration-danger="entry_type in ('agent_payment', 'expense', 'transfer_out')"/>
                <field name="debit" sum="Total Debit" decoration-success="debit &gt; 0" decoration-bf="debit &gt; 0"/>
                <field name="credit" sum="Total Credit" decoration-danger="credit &gt; 0" decoration-bf="credit &gt; 0"/>
                <field name="balance" sum="Net Balance" decoration-danger="balance &lt; 0" decoration-success="balance &gt; 0" decoration-bf="balance != 0"/>
                <field name="reference"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_flipkart_associate_ledger_summary_list" model="ir.ui.view">
        <field name="name">flipkart.associate.ledger.summary.list</field>
        <field name="model">flipkart.associate.ledger.summary</field>
        <field name="arch" type="xml">
