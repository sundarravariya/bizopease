                <button name="action_open_ledger_details" type="object" string="View Ledger" icon="fa-list"/>
            </list>
        </field>
    </record>

    <record id="view_flipkart_bill_payment_transaction_search" model="ir.ui.view">
        <field name="name">flipkart.bill.payment.transaction.search</field>
        <field name="model">flipkart.bill.payment.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Bill/Payment Transactions">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="received_by_id"/>
                <field name="carrying_agent_id"/>
                <field name="filter_date_from" string="From" filter_domain="[('date', '&gt;=', self)]"/>
                <field name="filter_date_to" string="To" filter_domain="[('date', '&lt;=', self)]"/>
                <separator/>
                <filter string="Last 30 Days" name="last_30_days" domain="[('date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last Year" name="last_year" domain="[('date', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

