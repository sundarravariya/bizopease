<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- business.ledger views -->
    <record id="view_business_ledger_list" model="ir.ui.view">
        <field name="name">business.ledger.list</field>
        <field name="model">business.ledger</field>
        <field name="arch" type="xml">
            <list string="Partner Ledger" create="0" edit="0" delete="1">
                <field name="date"/>
                <field name="move_id"/>
                <field name="ref"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="debit" sum="Total Debit" decoration-success="debit &gt; 0" decoration-bf="debit &gt; 0"/>
                <field name="credit" sum="Total Credit" decoration-danger="credit &gt; 0" decoration-bf="credit &gt; 0"/>
                <field name="balance" sum="Total Net Balance" decoration-danger="balance &lt; 0" decoration-success="balance &gt; 0" decoration-bf="balance != 0"/>
            </list>
        </field>
    </record>

    <record id="view_business_ledger_search" model="ir.ui.view">
        <field name="name">business.ledger.search</field>
        <field name="model">business.ledger</field>
        <field name="arch" type="xml">
            <search string="Search Ledger">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="ref"/>
                <field name="move_id"/>
                <field name="filter_date_from" string="From" filter_domain="[('date', '&gt;=', self)]"/>
                <field name="filter_date_to" string="To" filter_domain="[('date', '&lt;=', self)]"/>
                <separator/>
                <filter string="Last 30 Days" name="last_30_days" domain="[('date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last Year" name="last_year" domain="[('date', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Partner" context="{'group_by':'partner_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_business_ledger" model="ir.actions.act_window">
        <field name="name">Partner Ledger</field>
        <field name="res_model">business.ledger</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>

    <!-- manual entry wizard views -->
    <record id="view_business_manual_entry_form" model="ir.ui.view">
        <field name="name">business.manual.entry.form</field>
        <field name="model">business.manual.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual Ledger Entry">
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="entry_type"/>
                        <field name="amount"/>
                    </group>
                    <group colspan="2">
                        <field name="line_ids" widget="many2many" nolabel="1" colspan="2" placeholder="Select unpaid invoices or bills to settle...">
                            <list>
                                <field name="date"/>
                                <field name="move_id"/>
                                <field name="ref"/>
                                <field name="account_id"/>
                                <field name="amount_residual"/>
                            </list>
                        </field>
                    </group>
                </group>
                <footer>
                    <button name="action_post_entry" type="object" string="Post Entry" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_business_manual_entry" model="ir.actions.act_window">
        <field name="name">New Manual Entry</field>
        <field name="res_model">business.manual.entry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    

    <!-- business.ledger.summary views (Tally Group Summary) -->
    <record id="view_business_ledger_summary_list" model="ir.ui.view">
        <field name="name">business.ledger.summary.list</field>
        <field name="model">business.ledger.summary</field>
        <field name="arch" type="xml">
            <list string="Partner Ledger Summary" create="0" edit="0" delete="0">
                <field name="partner_id"/>
                <field name="balance" sum="Total Net Balance" decoration-danger="balance &lt; 0" decoration-success="balance &gt; 0" decoration-bf="balance != 0"/>
                <button name="action_open_ledger_details" type="object" string="View Ledger" icon="fa-list"/>
            </list>
        </field>
    </record>

    <record id="view_business_ledger_summary_search" model="ir.ui.view">
        <field name="name">business.ledger.summary.search</field>
        <field name="model">business.ledger.summary</field>
        <field name="arch" type="xml">
            <search string="Search Partner Ledger Summary">
                <field name="partner_id"/>
            </search>
        </field>
    </record>

    <record id="action_business_ledger_summary" model="ir.actions.act_window">
        <field name="name">Partner Ledger Summary</field>
        <field name="res_model">business.ledger.summary</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No ledger activity yet!
            </p>
        </field>
    </record>

</odoo>
