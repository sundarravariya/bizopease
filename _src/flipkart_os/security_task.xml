<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employees: strictly only tasks assigned to them. -->
    <record id="rule_robifel_task_own" model="ir.rule">
        <field name="name">Robifel Task: own tasks</field>
        <field name="model_id" ref="model_robifel_task"/>
        <field name="domain_force">[('assignee_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Managers (Settings/admin): see and manage every task. -->
    <record id="rule_robifel_task_all" model="ir.rule">
        <field name="name">Robifel Task: all tasks (managers)</field>
        <field name="model_id" ref="model_robifel_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
