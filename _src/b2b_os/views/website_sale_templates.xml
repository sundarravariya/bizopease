                      class="fw-bold"
                      name="product_price"
                      t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                <del t-if="data.get('has_discounted_price')" class="text-danger ms-1 h6" style="white-space: nowrap;"
                     t-esc="data['list_price']"
                     t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
            </t>
        </xpath>
    </template>

