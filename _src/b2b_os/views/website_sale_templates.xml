        <xpath expr="//div[hasclass('o_dynamic_snippet_btn_wrapper')]" position="replace">
            <div class="o_dynamic_snippet_btn_wrapper d-flex flex-column align-items-start gap-2 w-100">
                <div class="b2b_dynamic_price_line w-100" t-if="not data.get('b2b_hide_price') and not data.get('is_sample')">
                    <span t-esc="data['price']"
                          class="fw-bold"
                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    <del t-if="data.get('has_discounted_price')" class="text-danger ms-1 h6"
                         t-esc="data['list_price']"
                         t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                </div>
                <div class="d-flex align-items-center gap-2 w-100">
                <div class="css_quantity input-group input-group-sm b2b_qty_group" style="max-width:118px;">
                    <a href="#" class="btn btn-outline-secondary b2b_qty_action b2b_qty_minus">
                        <span class="fa fa-minus"/>
                    </a>
                    <input type="text" name="add_qty" class="form-control quantity text-center" value="1" data-min="1"/>
                    <a href="#" class="btn btn-outline-secondary b2b_qty_action b2b_qty_plus">
                        <span class="fa fa-plus"/>
                    </a>
                </div>
                <button
                    type="button"
