    </template>

    <template id="hide_product_share_buttons_b2b" inherit_id="website_sale.product_share_buttons" priority="140">
        <xpath expr="//div[hasclass('s_share')]" position="replace">
            <div class="d-none"/>
        </xpath>
    </template>

    <template id="hide_product_terms_and_share_wrapper_b2b" inherit_id="website_sale.product" priority="145">
        <xpath expr="//div[@id='o_product_terms_and_share']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
    </template>

    <template id="hide_original_ecommerce_description_b2b" inherit_id="website_sale.product" priority="146">
        <xpath expr="//div[@t-field='product.description_ecommerce']" position="replace">
            <div class="d-none"/>
        </xpath>
    </template>

    <template id="show_ecommerce_description_below_cart_b2b" inherit_id="website_sale.product" priority="150">
        <xpath expr="//div[@id='o_product_terms_and_share']" position="after">
            <t t-set="b2b_base_url" t-value="request.httprequest.url_root.rstrip('/')"/>
            <a class="b2b_whatsapp_enquiry"
               target="_blank"
               rel="noopener"
               aria-label="Enquire on WhatsApp"
               title="Enquire on WhatsApp"
               t-attf-href="https://wa.me/919819816402?text=#{product.name}%0A#{b2b_base_url}/web/image/product.template/#{product.id}/image_512">
                <i class="fa fa-whatsapp" aria-hidden="true"/>
                <span>WhatsApp Enquiry</span>
            </a>
            <div t-if="product.description_ecommerce"
                 class="b2b_product_ecommerce_description mt-3 mb-3 text-muted"
                 t-field="product.description_ecommerce">
            </div>
        </xpath>
    </template>


    <template id="b2b_product_zoom_icon" inherit_id="website_sale.product" priority="155">
        <xpath expr="//div[hasclass('o_wsale_product_page')]" position="attributes">
            <attribute name="data-ecom-zoom-click">1</attribute>
            <attribute name="class" separator=" " add="ecom-zoomable zoomodoo-next"/>
        </xpath>
        <xpath expr="//div[@id='product_detail_main']" position="inside">
            <div class="b2b_zoom_icon_hint" aria-hidden="true">
                <i class="fa fa-search-plus"/>
            </div>
        </xpath>
    </template>

</odoo>
