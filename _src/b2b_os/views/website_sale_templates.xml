                         t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"
                         style="white-space: nowrap;"/>
                    <span t-esc="combination_info['price']"
                          t-options="{'widget': 'monetary','display_currency': website.currency_id}"
                          style="white-space: nowrap;"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="hide_dynamic_product_price_b2b" inherit_id="website_sale.price_dynamic_filter_template_product_product" priority="110">
        <xpath expr="." position="replace">
            <t t-if="data.get('b2b_hide_price')">
